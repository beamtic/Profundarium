APP_NAME="Beamtic Profundarium"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel.localhost

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=debug
CACHE_STORE=file

# Docker-internal URL when developing with Sandboxer.
HEDGEDOC_URL=http://hedgedoc:3000

# Optional media commands: public URL, local uploads mount, and database access.
HEDGEDOC_PUBLIC_URL=http://hedgedoc-dev.localhost
HEDGEDOC_UPLOADS_PATH=/srv/hedgedoc-dev/uploads
# Choose pgsql, mysql (also MariaDB), mariadb, or sqlite. For sqlite, set DATABASE to the mounted file path.
HEDGEDOC_DB_CONNECTION=pgsql
HEDGEDOC_DB_HOST=hedgedoc-dev-db
HEDGEDOC_DB_PORT=5432
HEDGEDOC_DB_DATABASE=hedgedoc
HEDGEDOC_DB_USERNAME=hedgedoc
HEDGEDOC_DB_PASSWORD=
HEDGEDOC_DB_SCHEMA=public
HEDGEDOC_DB_SSLMODE=prefer
